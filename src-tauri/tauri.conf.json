{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siakap Terminal",
  "version": "0.8.1",
  "identifier": "dev.siakap.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Siakap Terminal",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#0d1117",
        "dragDropEnabled": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Siakap",
    "shortDescription": "Secure terminal and SSH client",
    "copyright": "Proprietary. Internal use only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "headerImage": "windows/nsis-header.bmp"
      },
      "wix": {
        "bannerPath": "windows/msi-banner.bmp",
        "dialogImagePath": "windows/msi-dialog.bmp"
      }
    }
  }
}
